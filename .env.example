# ==============================================================================
# GOVERNED AI DATABASE COPILOT - PRODUCTION & LOCAL ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your secrets. NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM API Key (Groq LLaMA 3.3 70B)
# Get your free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 2. Security & Encryption Secrets (Mandatory for Production)
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate JWT secret: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
VAULT_ENCRYPTION_KEY=your_generated_fernet_key_here
JWT_SECRET=your_generated_jwt_secret_here

# ------------------------------------------------------------------------------
# 3. Vector Database (Qdrant)
# Option A: Local Docker (Default)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_PREFIX=db_copilot_

# Option B: Qdrant Cloud (Free cluster at https://cloud.qdrant.io)
# Uncomment these two lines if using Qdrant Cloud instead of local Docker:
# QDRANT_URL=https://xyz-your-cluster.qdrant.tech:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# ------------------------------------------------------------------------------
# 4. Target Database Credentials (Your Sample or Production DB)
# For local seeded DB via Docker Compose:
SAMPLE_DB_HOST=localhost
SAMPLE_DB_PORT=5432
SAMPLE_DB_NAME=ecommerce_demo
SAMPLE_DB_USER=postgres
SAMPLE_DB_PASSWORD=postgres
SAMPLE_DB_SSLMODE=disable

# ------------------------------------------------------------------------------
# 5. Service Host & Port Bindings
# ------------------------------------------------------------------------------
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8000
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# ------------------------------------------------------------------------------
# 6. Frontend Public URLs (Next.js)
# In production on Vercel/Render, point to your deployed backend URLs:
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8001

# ------------------------------------------------------------------------------
# 7. Governance & Safety Policy Limits
# ------------------------------------------------------------------------------
DEFAULT_MAX_ROWS_PER_QUERY=100
CONFIRMATION_TOKEN_EXPIRY_SECONDS=300
ROLLBACK_WINDOW_MINUTES=5
