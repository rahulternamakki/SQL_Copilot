# ==============================================================================
# GOVERNED AI DATABASE COPILOT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your secrets. NEVER commit .env to git.
# ==============================================================================

# LLM Configuration (Groq API by default, swappable to Anthropic/OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.0

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_PREFIX=db_copilot_

# Embedding Model Configuration
# Options: text-embedding-3-small, voyage-3, or HuggingFace local models
EMBEDDING_PROVIDER=groq_or_fastembed
EMBEDDING_MODEL=text-embedding-3-small

# Credential Vault Encryption Key (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
VAULT_ENCRYPTION_KEY=generate_fernet_key_and_paste_here

# Sample PostgreSQL Database (Spin up via docker-compose inside /infra)
SAMPLE_DB_HOST=localhost
SAMPLE_DB_PORT=5432
SAMPLE_DB_NAME=ecommerce_demo
SAMPLE_DB_USER=postgres
SAMPLE_DB_PASSWORD=postgres
SAMPLE_DB_SSLMODE=disable

# Service Ports & Networking
AGENT_SERVICE_HOST=0.0.0.0
AGENT_SERVICE_PORT=8000
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_URL=http://localhost:8001

# Safety & Governance Policy Defaults
DEFAULT_MAX_ROWS_PER_QUERY=100
CONFIRMATION_TOKEN_EXPIRY_SECONDS=300
ROLLBACK_WINDOW_MINUTES=5
